import argparse
import json
from pathlib import Path

FILE = Path("todos.json")


def load() -> list[dict]:
    return json.loads(FILE.read_text()) if FILE.exists() else []


def save(todos: list[dict]) -> None:
    FILE.write_text(json.dumps(todos, indent=2))


def show(todos: list[dict]) -> None:
    if not todos:
        print("Nothing to do!")
    for i, task in enumerate(todos, 1):
        mark = "x" if task["done"] else " "
        print(f"{i}. [{mark}] {task['title']}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Simple to-do list")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="show all tasks")
    sub.add_parser("add", help="add a task").add_argument("title")
    sub.add_parser("done", help="mark a task as done").add_argument("number", type=int)
    sub.add_parser("remove", help="delete a task").add_argument("number", type=int)

    args = parser.parse_args()
    todos = load()

    if args.cmd == "add":
        todos.append({"title": args.title, "done": False})
    elif args.cmd in ("done", "remove"):
        if not 1 <= args.number <= len(todos):
            parser.error(f"There is no task #{args.number}")
        if args.cmd == "done":
            todos[args.number - 1]["done"] = True
        else:
            todos.pop(args.number - 1)

    if args.cmd != "list":
        save(todos)
    show(todos)


if __name__ == "__main__":
    main()
